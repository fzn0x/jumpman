---
import Icon from '../../components/Icon.astro'
import Base from '../../layouts/Base.astro'
import {
  layerLabels,
  loadCommunityPresets,
  presetInWords,
  presetStrip,
  tryInAppUrl,
} from '../../lib/presets'
import { links } from '../../lib/site'

const presets = loadCommunityPresets().map((preset) => ({
  preset,
  strip: presetStrip(preset),
  words: presetInWords(preset),
  layers: layerLabels(preset),
  href: tryInAppUrl(preset),
}))
---

<Base
  title="Community presets for Jumpman | Free photo presets and LUT looks"
  description="Free community presets for Jumpman, the open-source batch photo editor. Preview a look on your own batch of photos in one tap, then save, fork or remix it."
>
  <section class="intro" aria-labelledby="presets-title">
    <div class="container">
      <h1 id="presets-title" class="display-xl">Community presets.</h1>
      <div class="intro-row">
        <p class="lead">
          Every look here was made in Jumpman and shared as a preset.
          Tap <strong>Try in Jumpman</strong> to open it in the app and preview it on your own batch
          before you save it.
        </p>
        <p class="meta">
          <span>{presets.length} presets</span>
          <span>Free to use and remix</span>
          <a href={links.galleryJson}>JSON feed</a>
        </p>
      </div>
    </div>
  </section>

  <section class="gallery" aria-label="Presets">
    <div class="container">
      <ul class="cards" role="list">
        {
          presets.map(({ preset, strip, words, layers, href }) => (
            <li class="card dark">
              <div class="strip" style={`background-image: ${strip}`}>
                <span class="ticks" aria-hidden="true" />
              </div>
              <div class="body">
                <div class="title-row">
                  <h2>{preset.name}</h2>
                  {preset.author && <p class="author">by {preset.author}</p>}
                </div>
                {preset.description && <p class="desc">{preset.description}</p>}
                {words && (
                  <p class="words">
                    <span class="label">Feels</span> {words}
                  </p>
                )}
                <div class="stack">
                  <span class="label">Layers</span>
                  <ul role="list">
                    {layers.map((layer) => (
                      <li>{layer}</li>
                    ))}
                  </ul>
                </div>
                {preset.tags && preset.tags.length > 0 && (
                  <ul class="tags" role="list" aria-label="Tags">
                    {preset.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                )}
              </div>
              <div class="foot">
                <a class="btn btn--primary" href={href} aria-label={`Try ${preset.name} in Jumpman`}>
                  Try in Jumpman
                  <Icon name="arrow-right" />
                </a>
              </div>
            </li>
          ))
        }
      </ul>

      <aside class="share" aria-labelledby="share-title">
        <div class="share-copy">
          <h2 id="share-title" class="display-m">Share your own.</h2>
          <p>
            Made a look you love? Export it from Jumpman and open a pull request. Every preset is checked
            with the same parser the app uses, then shows up here and in the app’s Community tab.
          </p>
        </div>
        <ol class="share-steps" role="list">
          <li>
            In Jumpman, open <strong>Looks → My presets</strong>, then <strong>⋯ → Export file</strong>.
          </li>
          <li>
            Add the file to <code>community/presets/</code> with your GitHub handle as the author, a short
            description and a few tags.
          </li>
          <li>Run <code>pnpm presets:validate</code> and open a pull request.</li>
        </ol>
        <div class="share-actions">
          <a class="btn" href={links.communityPresets} rel="noopener">
            Read the guide
            <Icon name="arrow-up-right" />
          </a>
          <a class="btn btn--ghost" href={links.communityFolder} rel="noopener">
            <Icon name="github" />
            Browse the folder
          </a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-block: clamp(2.5rem, 1rem + 5vw, 5.5rem) clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  h1 {
    color: var(--ink);
    font-size: clamp(3rem, 1rem + 7vw, 7.5rem);
  }

  .intro-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }

  .lead {
    color: var(--ink);
    max-width: 36rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .meta > * {
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: rgb(28 28 30 / 0.1);
  }

  .meta a {
    text-decoration: none;
    box-shadow: inset 0 0 0 1.5px var(--ink);
    background: transparent;
  }

  .meta a:hover {
    background: rgb(28 28 30 / 0.08);
  }

  .gallery {
    padding-bottom: clamp(4.5rem, 3rem + 7vw, 9rem);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
    border-radius: 1.5rem;
    box-shadow: 0 24px 48px -28px rgb(70 0 10 / 0.6);
  }

  .strip {
    position: relative;
    height: 6.5rem;
  }

  .strip .ticks {
    position: absolute;
    inset: auto 1rem 0.75rem;
    color: rgb(255 255 255 / 0.7);
    background-image:
      linear-gradient(var(--white), var(--white)),
      repeating-linear-gradient(90deg, currentColor 0 1px, transparent 1px 3.125rem),
      repeating-linear-gradient(90deg, currentColor 0 1px, transparent 1px 0.625rem);
  }

  .body {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.5rem 1.5rem 0.5rem;
  }

  .title-row {
    display: grid;
    gap: 0.25rem;
  }

  h2 {
    font-size: 1.85rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .author {
    color: var(--gray);
    font-size: 0.9375rem;
  }

  .desc {
    color: var(--mist);
  }

  .label {
    margin-right: 0.35rem;
    color: var(--gray);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .words {
    font-size: 0.9375rem;
    color: var(--white);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .stack ul,
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .stack li {
    padding: 0.25rem 0.65rem;
    border-radius: 0.5rem;
    background: var(--ink-raised);
    font-size: 0.8125rem;
    font-weight: 550;
  }

  .tags li {
    color: var(--salmon);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .tags li::before {
    content: '#';
    color: var(--gray);
  }

  .foot {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .foot .btn {
    width: 100%;
  }

  .share {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 4vw, 4rem);
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    border: 2px solid var(--ink);
    border-radius: var(--radius-lg);
  }

  .share-copy {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .share-copy p {
    color: var(--ink-soft);
    max-width: 32rem;
  }

  .share-steps {
    display: grid;
    gap: 0.9rem;
    counter-reset: step;
  }

  .share-steps li {
    position: relative;
    padding-left: 2.6rem;
    counter-increment: step;
  }

  .share-steps li::before {
    content: counter(step);
    position: absolute;
    top: -0.05rem;
    left: 0;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--white);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .share-steps code {
    padding: 0.1em 0.4em;
    border-radius: 0.35rem;
    background: rgb(28 28 30 / 0.1);
    overflow-wrap: anywhere;
  }

  .share-actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 48rem) {
    .share {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
