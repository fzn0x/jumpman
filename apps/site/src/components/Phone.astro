---
/** A pure-CSS phone frame around an app screenshot. Size it with `--phone-w` on the element. */
import type { Screen } from '../data/screens'
import { withBase } from '../lib/site'

interface Props {
  screen: Screen
  /** Above-the-fold phones load eagerly; the front one gets high fetch priority. */
  priority?: 'high' | 'eager' | 'lazy'
  class?: string
}

const { screen, priority = 'lazy', class: className } = Astro.props
---

<div class:list={['phone', className]}>
  <img
    src={withBase(screen.src)}
    alt={screen.alt}
    width="390"
    height="844"
    loading={priority === 'lazy' ? 'lazy' : 'eager'}
    fetchpriority={priority === 'high' ? 'high' : undefined}
    decoding="async"
  />
</div>

<style>
  .phone {
    --w: var(--phone-w, 18rem);
    position: relative;
    width: var(--w);
    padding: calc(var(--w) * 0.034);
    border-radius: calc(var(--w) * 0.16);
    background: #0d0d0e;
    box-shadow:
      inset 0 0 0 1.5px #4a4a4e,
      inset 0 0 0 calc(var(--w) * 0.014) var(--ink),
      0 1px 2px rgb(60 0 0 / 0.25),
      0 12px 24px -10px rgb(70 0 10 / 0.4),
      0 40px 70px -24px rgb(70 0 10 / 0.5);
  }

  /* Dynamic island */
  .phone::before {
    content: '';
    position: absolute;
    z-index: 1;
    top: calc(var(--w) * 0.06);
    left: 50%;
    width: 30%;
    height: calc(var(--w) * 0.085);
    border-radius: 999px;
    background: #000;
    translate: -50% 0;
  }

  /* Side button */
  .phone::after {
    content: '';
    position: absolute;
    top: 24%;
    right: -2px;
    width: 3px;
    height: 11%;
    border-radius: 0 3px 3px 0;
    background: #3a3a3c;
  }

  img {
    width: 100%;
    height: auto;
    border-radius: calc(var(--w) * 0.128);
    background: var(--ink);
  }
</style>
