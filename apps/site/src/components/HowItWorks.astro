---
const steps = [
  {
    title: 'Collect',
    text: 'Drop photos into a collection like “Spring Pink”. They stay on your device. Nothing is uploaded, ever.',
  },
  {
    title: 'Select',
    text: 'Tap the shots you want, or let smart selection grab every photo from the same moment, scene or palette.',
  },
  {
    title: 'Edit together',
    text: 'Every slider, layer and preset lands on the whole selection. Flip to Individual to fine-tune one photo without breaking the set.',
  },
]
---

<section class="how" id="how-it-works" aria-labelledby="how-title">
  <div class="container">
    <div class="panel dark">
      <div class="head">
        <h2 id="how-title" class="display-l">
          Three steps. <span class="accent">Any</span> number of photos.
        </h2>
        <p class="lead">
          No exporting one shot at a time, no syncing settings by hand. Jumpman treats a batch like a
          single image, until you want it not to.
        </p>
      </div>

      <div class="ticks" aria-hidden="true"></div>

      <ol class="steps" role="list">
        {
          steps.map((step, i) => (
            <li class="step">
              <div class="art" aria-hidden="true">
                {i === 0 && (
                  <svg viewBox="0 0 280 168" width="280" height="168">
                    <defs>
                      <linearGradient id="hw-a" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#FFC9AE" />
                        <stop offset="1" stop-color="#F06A80" />
                      </linearGradient>
                      <linearGradient id="hw-b" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#BFE3F0" />
                        <stop offset="1" stop-color="#3E8FB0" />
                      </linearGradient>
                      <linearGradient id="hw-c" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#F8DDB8" />
                        <stop offset="1" stop-color="#D08C5B" />
                      </linearGradient>
                    </defs>
                    <rect x="22" y="30" width="58" height="70" rx="9" fill="url(#hw-b)" transform="rotate(-12 51 65)" />
                    <rect x="44" y="64" width="58" height="70" rx="9" fill="url(#hw-c)" transform="rotate(8 73 99)" />
                    <rect x="34" y="44" width="58" height="70" rx="9" fill="url(#hw-a)" stroke="#1C1C1E" stroke-width="3" transform="rotate(-2 63 79)" />
                    <path d="M120 84h34m-9-9 9 9-9 9" fill="none" stroke="#A1A1A6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    <rect x="168" y="30" width="94" height="108" rx="14" fill="#1C1C1E" stroke="#3A3A3C" stroke-width="1.5" />
                    <rect x="178" y="40" width="35" height="35" rx="6" fill="url(#hw-a)" />
                    <rect x="217" y="40" width="35" height="35" rx="6" fill="url(#hw-b)" />
                    <rect x="178" y="79" width="35" height="35" rx="6" fill="url(#hw-c)" />
                    <rect x="217" y="79" width="35" height="35" rx="6" fill="#3A3A3C" />
                    <path d="M234.5 89v15M227 96.5h15" stroke="#FFA0A0" stroke-width="2.5" stroke-linecap="round" />
                    <rect x="178" y="121" width="48" height="6" rx="3" fill="#A1A1A6" />
                  </svg>
                )}
                {i === 1 && (
                  <svg viewBox="0 0 280 168" width="280" height="168">
                    <defs>
                      <linearGradient id="hw-d" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#FFD9D4" />
                        <stop offset="1" stop-color="#FF9A9A" />
                      </linearGradient>
                      <linearGradient id="hw-e" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#DCEBD2" />
                        <stop offset="1" stop-color="#7BAE7F" />
                      </linearGradient>
                      <linearGradient id="hw-f" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#FFB49C" />
                        <stop offset="1" stop-color="#B8405E" />
                      </linearGradient>
                    </defs>
                    <g>
                      <rect x="38" y="18" width="62" height="62" rx="9" fill="url(#hw-f)" />
                      <rect x="109" y="18" width="62" height="62" rx="9" fill="url(#hw-d)" />
                      <rect x="180" y="18" width="62" height="62" rx="9" fill="url(#hw-e)" opacity=".35" />
                      <rect x="38" y="88" width="62" height="62" rx="9" fill="url(#hw-e)" opacity=".35" />
                      <rect x="109" y="88" width="62" height="62" rx="9" fill="url(#hw-f)" />
                      <rect x="180" y="88" width="62" height="62" rx="9" fill="url(#hw-d)" />
                    </g>
                    <g fill="none" stroke="#E00000" stroke-width="3">
                      <rect x="39.5" y="19.5" width="59" height="59" rx="8" />
                      <rect x="110.5" y="19.5" width="59" height="59" rx="8" />
                      <rect x="110.5" y="89.5" width="59" height="59" rx="8" />
                      <rect x="181.5" y="89.5" width="59" height="59" rx="8" />
                    </g>
                    <g>
                      <circle cx="88" cy="30" r="9" fill="#E00000" stroke="#fff" stroke-width="2" />
                      <circle cx="159" cy="30" r="9" fill="#E00000" stroke="#fff" stroke-width="2" />
                      <circle cx="159" cy="100" r="9" fill="#E00000" stroke="#fff" stroke-width="2" />
                      <circle cx="230" cy="100" r="9" fill="#E00000" stroke="#fff" stroke-width="2" />
                      <circle cx="230" cy="30" r="8" fill="none" stroke="#A1A1A6" stroke-width="2" />
                      <circle cx="88" cy="100" r="8" fill="none" stroke="#A1A1A6" stroke-width="2" />
                    </g>
                    <g fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m84.5 30 2.5 2.5 4.5-5" />
                      <path d="m155.5 30 2.5 2.5 4.5-5" />
                      <path d="m155.5 100 2.5 2.5 4.5-5" />
                      <path d="m226.5 100 2.5 2.5 4.5-5" />
                    </g>
                  </svg>
                )}
                {i === 2 && (
                  <svg viewBox="0 0 280 168" width="280" height="168">
                    <defs>
                      <linearGradient id="hw-g" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#FFD0C4" />
                        <stop offset="1" stop-color="#F27C8A" />
                      </linearGradient>
                    </defs>
                    <g fill="url(#hw-g)">
                      <rect x="38" y="14" width="62" height="54" rx="9" />
                      <rect x="109" y="14" width="62" height="54" rx="9" />
                      <rect x="180" y="14" width="62" height="54" rx="9" />
                      <rect x="38" y="76" width="62" height="54" rx="9" />
                      <rect x="109" y="76" width="62" height="54" rx="9" />
                      <rect x="180" y="76" width="62" height="54" rx="9" />
                    </g>
                    <g fill="#FFE9C9">
                      <circle cx="80" cy="34" r="8" />
                      <circle cx="151" cy="34" r="8" />
                      <circle cx="222" cy="34" r="8" />
                      <circle cx="80" cy="96" r="8" />
                      <circle cx="151" cy="96" r="8" />
                      <circle cx="222" cy="96" r="8" />
                    </g>
                    <g fill="#A63B5C">
                      <path d="M38 58l18-14 14 10 14-12 16 12v8a9 9 0 0 1-9 8H47a9 9 0 0 1-9-8Z" />
                      <path d="M109 58l18-14 14 10 14-12 16 12v8a9 9 0 0 1-9 8h-44a9 9 0 0 1-9-8Z" />
                      <path d="M180 58l18-14 14 10 14-12 16 12v8a9 9 0 0 1-9 8h-44a9 9 0 0 1-9-8Z" />
                      <path d="M38 120l18-14 14 10 14-12 16 12v8a9 9 0 0 1-9 8H47a9 9 0 0 1-9-8Z" />
                      <path d="M109 120l18-14 14 10 14-12 16 12v8a9 9 0 0 1-9 8h-44a9 9 0 0 1-9-8Z" />
                      <path d="M180 120l18-14 14 10 14-12 16 12v8a9 9 0 0 1-9 8h-44a9 9 0 0 1-9-8Z" />
                    </g>
                    <rect x="38" y="146" width="204" height="4" rx="2" fill="#3A3A3C" />
                    <rect x="38" y="146" width="132" height="4" rx="2" fill="#E00000" />
                    <circle cx="170" cy="148" r="8" fill="#fff" stroke="#E00000" stroke-width="3" />
                  </svg>
                )}
              </div>
              <div class="text">
                <h3>
                  <span class="num" aria-hidden="true">{i + 1}</span>
                  {step.title}
                </h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .how {
    padding-bottom: clamp(4.5rem, 3rem + 7vw, 9rem);
  }

  .panel {
    padding: clamp(2.5rem, 1.5rem + 4vw, 5.5rem) clamp(1.25rem, 0.5rem + 4vw, 4.5rem);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 60px -30px rgb(70 0 10 / 0.5);
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: end;
    gap: 1.5rem 3rem;
  }

  .accent {
    color: var(--red);
  }

  .lead {
    color: var(--mist);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.2rem);
  }

  .ticks {
    margin-block: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .art {
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 3;
    border-radius: 1.25rem;
    background: var(--ink-raised);
  }

  .art svg {
    width: 88%;
    height: auto;
  }

  .text {
    margin-top: 1.5rem;
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2rem);
    letter-spacing: -0.03em;
  }

  .num {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
    font: 700 1rem / 1 var(--font-body);
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }

  .text p {
    margin-top: 0.75rem;
    color: var(--mist);
    max-width: 34ch;
  }

  @media (max-width: 56rem) {
    .head {
      grid-template-columns: minmax(0, 1fr);
    }

    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .step {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      align-items: center;
      gap: 1.5rem;
    }

    .text {
      margin-top: 0;
    }
  }

  @media (max-width: 34rem) {
    .step {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }
</style>
