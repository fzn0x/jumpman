---
import { screen } from '../data/screens'
import { links } from '../lib/site'
import Icon from './Icon.astro'
import Phone from './Phone.astro'

const trust = ['Free & open source', 'Works offline', 'No account', 'Your photos never leave your device']
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container grid">
    <h1 id="hero-title" class="display-xl title">
      Edit <span class="red">Multiple</span> photos at once.
    </h1>
    <div class="copy">
      <p class="lead">
        Jumpman is a free, open-source batch photo editor. Select a set, make one edit, and every
        shot follows, with per-photo control whenever you want it.
      </p>
      <div class="ctas">
        <a class="btn btn--primary btn--lg" href={links.app}>
          Open the web app
          <Icon name="arrow-right" />
        </a>
        <a class="btn btn--lg" href={links.releases} rel="noopener">
          <Icon name="android" />
          Download for Android
        </a>
        <a class="btn btn--ghost btn--lg" href={links.repo} rel="noopener">
          <Icon name="star" />
          Star on GitHub
        </a>
      </div>
      <ul class="trust" role="list" aria-label="Why Jumpman">
        {trust.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="stage" role="group" aria-label="Jumpman app screenshots">
      <Phone screen={screen('collection')} priority="eager" class="p p-left" />
      <Phone screen={screen('layers')} priority="eager" class="p p-right" />
      <Phone screen={screen('editor')} priority="high" class="p p-front" />
      <p class="callout" aria-hidden="true">
        <span class="dot"></span>
        One edit · 12 photos
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1rem + 5vw, 5.5rem) clamp(3.5rem, 2rem + 6vw, 7rem);
    overflow-x: clip;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'title title'
      'copy stage';
    align-items: start;
    column-gap: clamp(2rem, 4vw, 4rem);
  }

  .title {
    grid-area: title;
    position: relative;
    z-index: 2;
    color: var(--white);
    font-size: clamp(3.4rem, 1rem + 8.6vw, 9.5rem);
  }

  .copy {
    grid-area: copy;
    padding-top: clamp(1.75rem, 1rem + 2.5vw, 3.25rem);
  }

  .lead {
    color: var(--ink);
    max-width: 31rem;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    max-width: 34rem;
    margin-top: 1.75rem;
    font-size: 0.9375rem;
    font-weight: 550;
    color: var(--ink);
  }

  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .trust li::before {
    content: '';
    flex: none;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--red);
  }

  /* Phone cluster: sized from its own width so it scales cleanly to 360px. */
  .stage {
    grid-area: stage;
    container-type: inline-size;
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    margin-top: clamp(-4rem, -4vw, -1rem);
    padding-block: 0 2rem;
  }

  .stage::before {
    content: '';
    position: absolute;
    inset: 8% 4%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.45), rgb(255 255 255 / 0));
    pointer-events: none;
  }

  .stage :global(.p) {
    grid-area: 1 / 1;
  }

  .stage :global(.p-front) {
    --phone-w: min(47cqi, 19.5rem);
    z-index: 2;
  }

  .stage :global(.p-left),
  .stage :global(.p-right) {
    --phone-w: min(39cqi, 16rem);
    z-index: 1;
  }

  .stage :global(.p-left) {
    translate: -58% 7%;
    rotate: -9deg;
  }

  .stage :global(.p-right) {
    translate: 58% 9%;
    rotate: 8deg;
  }

  .callout {
    position: absolute;
    z-index: 3;
    top: 9%;
    right: max(0rem, 50% - 15.5rem);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1rem 0.6rem 0.85rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    font-size: 0.9375rem;
    font-weight: 600;
    white-space: nowrap;
    box-shadow:
      0 2px 4px rgb(60 0 0 / 0.2),
      0 16px 32px -12px rgb(60 0 0 / 0.5);
    rotate: 4deg;
  }

  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 3px rgb(224 0 0 / 0.3);
  }

  /* The one authored moment: the batch fans out from a single stack. */
  @media (prefers-reduced-motion: no-preference) {
    .stage :global(.p-left),
    .stage :global(.p-right) {
      animation: fan-out 1.3s var(--ease-out) 0.2s both;
    }

    .stage :global(.p-front) {
      animation: settle 1.1s var(--ease-out) 0.1s both;
    }

    .callout {
      animation: pop 0.8s var(--ease-out) 0.9s both;
    }
  }

  @keyframes fan-out {
    from {
      translate: 0 4%;
      rotate: 0deg;
    }
  }

  @keyframes settle {
    from {
      translate: 0 3%;
    }
  }

  @keyframes pop {
    from {
      scale: 0.6;
      rotate: 0deg;
      opacity: 0;
    }
  }

  @media (max-width: 62rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'title' 'copy' 'stage';
    }

    .stage {
      margin: 2.5rem calc(-1 * var(--gutter)) 0;
      padding-block: 1rem 2rem;
    }

    .stage :global(.p-front) {
      --phone-w: min(47cqi, 17rem);
    }

    .stage :global(.p-left),
    .stage :global(.p-right) {
      --phone-w: min(39cqi, 14rem);
    }

    .callout {
      top: 4%;
      right: max(0.75rem, 50% - 13.5rem);
      font-size: 0.875rem;
    }
  }

  @media (max-width: 30rem) {
    .ctas .btn {
      flex: 1 1 100%;
      min-height: 3.25rem;
    }
  }
</style>
