---
/**
 * Hand-drawn icon set: 24px grid, 1.75 stroke, round caps and joins.
 * The two brand marks (GitHub, Android) are filled glyphs.
 */
export type IconName =
  | 'arrow-right'
  | 'arrow-up-right'
  | 'github'
  | 'android'
  | 'check'
  | 'clock'
  | 'globe'
  | 'phone'
  | 'server'
  | 'terminal'
  | 'copy'
  | 'menu'
  | 'close'
  | 'star'
  | 'download'
  | 'folder'
  | 'sliders'
  | 'toggle'
  | 'layers'
  | 'dial'
  | 'shield'
  | 'wifi-off'

interface Props {
  name: IconName
  class?: string
  size?: number
  label?: string
}

const { name, class: className, size = 24, label } = Astro.props

const strokes: Partial<Record<IconName, string>> = {
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  clock: '<circle cx="12" cy="12" r="8.25"/><path d="M12 7.5V12l3 2"/>',
  globe:
    '<circle cx="12" cy="12" r="8.25"/><path d="M3.75 12h16.5M12 3.75c2.3 2.4 3.4 5.15 3.4 8.25S14.3 17.85 12 20.25C9.7 17.85 8.6 15.1 8.6 12S9.7 6.15 12 3.75Z"/>',
  phone:
    '<rect x="6.5" y="2.75" width="11" height="18.5" rx="2.75"/><path d="M10.5 5.75h3M11 18h2"/>',
  server:
    '<rect x="3.75" y="4" width="16.5" height="6.5" rx="1.75"/><rect x="3.75" y="13.5" width="16.5" height="6.5" rx="1.75"/><path d="M7.5 7.25h.01M7.5 16.75h.01M11 7.25h5M11 16.75h5"/>',
  terminal:
    '<rect x="2.75" y="4" width="18.5" height="16" rx="2.5"/><path d="m7 9.5 3 2.5-3 2.5M12.5 15h4.5"/>',
  copy: '<rect x="8.5" y="8.5" width="12" height="12" rx="2.25"/><path d="M15.5 8.5V5.75a2 2 0 0 0-2-2h-7.75a2 2 0 0 0-2 2v7.75a2 2 0 0 0 2 2H8.5"/>',
  menu: '<path d="M4 7.5h16M4 12h16M4 16.5h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  star: '<path d="m12 3.75 2.55 5.17 5.7.83-4.12 4.02.97 5.68L12 16.77l-5.1 2.68.97-5.68-4.12-4.02 5.7-.83L12 3.75Z"/>',
  download: '<path d="M12 3.75v11.5M7 10.5l5 5 5-5M4.75 19.75h14.5"/>',
  folder:
    '<path d="M3.75 7.25a2 2 0 0 1 2-2h3.6l2 2.25h6.9a2 2 0 0 1 2 2v7.75a2 2 0 0 1-2 2H5.75a2 2 0 0 1-2-2V7.25Z"/><path d="M8 13.5h8"/>',
  sliders:
    '<path d="M5 20v-6.5M5 9.5V4M12 20v-8.5M12 7.5V4M19 20v-4.5M19 11.5V4"/><path d="M2.75 13.5h4.5M9.75 7.5h4.5M16.75 15.5h4.5"/>',
  toggle:
    '<rect x="2.75" y="6.75" width="18.5" height="10.5" rx="5.25"/><circle cx="16" cy="12" r="2.75"/><path d="M6.5 12h3"/>',
  layers: '<path d="m12 3.75 8.5 4.5-8.5 4.5-8.5-4.5 8.5-4.5Z"/><path d="m3.5 12.25 8.5 4.5 8.5-4.5M3.5 16.25l8.5 4.5 8.5-4.5"/>',
  dial: '<path d="M4 15.5a8 8 0 0 1 16 0"/><path d="M12 15.5 15.5 10"/><path d="M3.75 19.5h16.5"/>',
  shield:
    '<path d="M12 3.25 19.25 6v5.5c0 4.4-3 7.85-7.25 9.25C7.75 19.35 4.75 15.9 4.75 11.5V6L12 3.25Z"/><path d="m9 12 2.2 2.2L15.25 10"/>',
  'wifi-off':
    '<path d="M3.5 3.5l17 17M8.6 13.6a5 5 0 0 1 4.65-1.2M5.3 10.5a9.6 9.6 0 0 1 3.1-1.95M12 6.25c3.2 0 6.15 1.2 8.4 3.25M12 18.25h.01"/>',
}

const fills: Partial<Record<IconName, string>> = {
  github:
    '<path d="M12 2.25a9.75 9.75 0 0 0-3.08 19c.49.09.67-.21.67-.47v-1.66c-2.71.59-3.28-1.31-3.28-1.31-.44-1.13-1.08-1.43-1.08-1.43-.89-.6.07-.59.07-.59.98.07 1.5 1.01 1.5 1.01.87 1.49 2.29 1.06 2.85.81.09-.63.34-1.06.62-1.3-2.16-.25-4.44-1.08-4.44-4.82 0-1.06.38-1.93 1-2.61-.1-.25-.43-1.24.1-2.58 0 0 .82-.26 2.68 1a9.3 9.3 0 0 1 4.88 0c1.86-1.26 2.68-1 2.68-1 .53 1.34.2 2.33.1 2.58.62.68 1 1.55 1 2.61 0 3.75-2.28 4.57-4.45 4.81.35.3.66.9.66 1.81v2.68c0 .26.18.57.68.47A9.75 9.75 0 0 0 12 2.25Z"/>',
  android:
    '<path d="M7.2 4.1a.6.6 0 0 1 .82.2l1.33 2.25A8.2 8.2 0 0 1 12 6.1c.93 0 1.82.16 2.65.45l1.33-2.25a.6.6 0 1 1 1.03.62l-1.28 2.17A7.6 7.6 0 0 1 19.6 13H4.4a7.6 7.6 0 0 1 3.87-5.91L6.99 4.92a.6.6 0 0 1 .21-.82ZM8.75 10.6a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8Zm6.5 0a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8ZM4.4 14.4h15.2v4.1a1.75 1.75 0 0 1-1.75 1.75H6.15A1.75 1.75 0 0 1 4.4 18.5v-4.1Z"/>',
}

const stroke = strokes[name]
const fill = fills[name]
const body = stroke ?? fill ?? ''
---

{
  stroke ? (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden={label ? undefined : 'true'}
      role={label ? 'img' : undefined}
      aria-label={label}
      focusable="false"
      set:html={body}
    />
  ) : (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden={label ? undefined : 'true'}
      role={label ? 'img' : undefined}
      aria-label={label}
      focusable="false"
      set:html={body}
    />
  )
}
