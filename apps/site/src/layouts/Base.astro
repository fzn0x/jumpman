---
import '@fontsource-variable/bricolage-grotesque'
import '@fontsource-variable/inter'
import '../styles/global.css'
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url'
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { SITE_NAME, withBase } from '../lib/site'

interface Props {
  title: string
  description: string
  /** Structured data for this page (JSON-LD). */
  jsonLd?: Record<string, unknown>
  noindex?: boolean
  ogImageAlt?: string
}

const {
  title,
  description,
  jsonLd,
  noindex = false,
  ogImageAlt = 'Jumpman: edit multiple photos at once. A free, open-source batch photo editor.',
} = Astro.props

const site = Astro.site ?? new URL('https://fzn0x.github.io')
const canonical = new URL(Astro.url.pathname, site).href
const ogImage = new URL(withBase('og.png'), site).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#FFA0A0" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="mask-icon" href={withBase('favicon.svg')} color="#E00000" />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
