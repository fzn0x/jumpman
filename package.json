{
  "name": "jumpman",
  "version": "0.1.0",
  "private": true,
  "description": "Edit multiple photos at once. Open-source, offline-first batch photo editor for web and mobile.",
  "type": "module",
  "license": "MIT",
  "author": "fzn0x",
  "homepage": "https://fzn0x.github.io/jumpman/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fzn0x/jumpman.git"
  },
  "bugs": "https://github.com/fzn0x/jumpman/issues",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @jumpman/web dev",
    "dev:site": "pnpm --filter @jumpman/site dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "lefthook install",
    "presets:validate": "node scripts/validate-presets.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "lefthook": "^2.2.1",
    "typescript": "^7.0.2"
  }
}
